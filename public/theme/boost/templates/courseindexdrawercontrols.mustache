{{!
    @template theme_boost/courseindexdrawercontrols

    A single toggle that expands or collapses all course index sections.

    Example context (json):
    {
    }
}}
<div id="courseindexdrawercontrols" class="mx-2 pb-2">
    <hr class="mt-0 mb-2 mx-3">
    <button type="button"
            class="courseindex-collapsemenu btn"
            aria-expanded="true"
            data-action="toggleallcourseindexsections">
        <span class="collapseall text-nowrap">
            {{#pix}} t/collapseall, core {{/pix}}{{#str}}collapseall{{/str}}
        </span>
        <span class="expandall text-nowrap">
            {{#pix}} t/expandall, core {{/pix}}{{#str}}expandall{{/str}}
        </span>
    </button>
</div>
{{#js}}
    require(['theme_boost/courseindexdrawercontrols'], function(component) {
    component.init('courseindexdrawercontrols');
    });
{{/js}}
