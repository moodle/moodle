{{!
    @template core/login_panel

    Lean left panel for ToBa Learn login — image carries the story; copy stays short.

    Example context (json):
    {
        "leftinstructions": ""
    }
}}
<div class="login-layout-left-content toba-login-panel" data-toba-login-panel>
    <p class="toba-login-eyebrow">ToBa Learn</p>
    <h1 class="toba-login-title">One account.<br>Two portals.</h1>
    <p class="toba-login-lead">Sign in once. Your enrolment opens the right portal.</p>

    <p class="toba-login-portal-line" data-portal-copy="employer">
        <span class="toba-login-chip"><i class="fa fa-building" aria-hidden="true"></i> Employer</span>
        <span class="toba-login-portal-text">Upskill assigned teams with mentor-reviewed work.</span>
    </p>

    <p class="toba-login-portal-line" data-portal-copy="fellowship" hidden>
        <span class="toba-login-chip"><i class="fa fa-graduation-cap" aria-hidden="true"></i> Fellowship</span>
        <span class="toba-login-portal-text">Bridge campus to craft defend your Demo Day.</span>
    </p>
</div>
