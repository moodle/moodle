{{!
    @template local_launchpad/employer_home

    Employer home — polished Fellowship-aligned composition over live Moodle data.
}}
<div class="lp-hero lp-reveal" data-region="employer-hero" style="--lp-d:0">
  <span class="lp-eyebrow">{{strings.eyebrow}}</span>
  <h2>{{strings.welcome}}</h2>
  <p class="lp-hero-lead">{{strings.assignedhelp}}</p>

  {{#hasnext}}
    <div class="lp-quest">
      <div>
        <span class="lp-eyebrow">{{strings.nextquest}}</span>
        <p class="lp-quest-title">{{nextactivity.name}}</p>
        <p class="lp-muted">{{nextactivity.modname}}{{#hasprimary}} · {{primarycourse.name}}{{/hasprimary}}</p>
      </div>
      <a class="lp-btn lp-btn-primary" href="{{nextactivity.url}}">{{strings.openactivity}}</a>
    </div>
  {{/hasnext}}
  {{^hasnext}}
    {{#hasprimary}}
      <div class="lp-quest">
        <div>
          <span class="lp-eyebrow">{{primarycourse.badge}}</span>
          <p class="lp-quest-title">{{primarycourse.name}}</p>
          <p class="lp-muted">{{#activitytotal}}{{strings.alldone}}{{/activitytotal}}{{^activitytotal}}{{primarycourse.progresslabel}}{{/activitytotal}}</p>
        </div>
        <a class="lp-btn lp-btn-primary" href="{{primarycourse.url}}">{{strings.opencourse}}</a>
      </div>
    {{/hasprimary}}
  {{/hasnext}}
</div>

{{#hastiles}}
<ul class="lp-tiles lp-reveal" aria-label="{{strings.overview}}" style="--lp-d:1">
  {{#tiles}}
    <li class="lp-tile" data-icon="{{icon}}">
      <span class="lp-tile-ico" aria-hidden="true"></span>
      <div class="lp-tile-text">
        <span class="lp-tile-label">{{label}}</span>
        <b class="lp-tile-value">{{value}}</b>
        <span class="lp-tile-sub">{{sub}}</span>
      </div>
    </li>
  {{/tiles}}
</ul>
{{/hastiles}}

{{#journey.has_gates}}
<section class="lp-card lift lp-journey-card lp-reveal" data-region="employer-journey" style="--lp-d:2">
  <div class="lp-card-head">
    <h2 class="lp-journey-title">{{strings.journey}}</h2>
    {{#hasprimary}}
      <a class="lp-link" href="{{primarycourse.url}}">{{strings.opentrack}} →</a>
    {{/hasprimary}}
  </div>
  <p class="lp-muted lp-sm">{{strings.journeyhelp}}</p>
  <div class="lp-journey{{#journey.compact}} compact{{/journey.compact}}" data-lp-journey>
    <div class="lp-journey-in">
      <svg viewBox="0 0 1000 {{journey.view_h}}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="{{strings.journey}}">
        <path d="{{journey.path_d}}" fill="none" stroke="var(--lp-blue-soft)" stroke-width="14" stroke-linecap="round"/>
        <path class="lp-journey-progress" d="{{journey.path_d}}" fill="none" stroke="var(--lp-blue)" stroke-width="14" stroke-linecap="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" data-to="{{journey.dash_offset}}"/>
        <path d="{{journey.path_d}}" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="2 14" stroke-linecap="round" opacity=".7"/>
        {{#journey.gates}}
          <g class="lp-jn {{status}}" transform="translate({{cx}},{{cy}})">
            <title>{{name}}</title>
            <circle r="{{ring_r}}" class="ring"/>
            <circle r="{{core_r}}" class="core"/>
            <text y="{{mark_y}}" text-anchor="middle">{{mark}}</text>
            <text class="lb" y="{{label_y}}" text-anchor="middle">{{short}}</text>
          </g>
        {{/journey.gates}}
      </svg>
      {{#bot_url}}
        <img class="lp-jbot" src="{{bot_url}}" alt="" style="left:{{journey.bot_left}};top:{{journey.bot_top}}">
      {{/bot_url}}
    </div>
  </div>
</section>
{{/journey.has_gates}}

{{#hasgates}}
<section class="lp-card lift lp-reveal" data-region="employer-sections" style="--lp-d:3">
  <div class="lp-card-head">
    <h3>{{strings.sections}}</h3>
    {{#hasprimary}}
      <a class="lp-link" href="{{primarycourse.url}}">{{strings.opencourse}} →</a>
    {{/hasprimary}}
  </div>
  <p class="lp-muted lp-sm">{{strings.sectionshelp}}</p>
  <ul class="lp-emp-gates">
    {{#gates}}
      <li class="{{#locked}}is-locked{{/locked}}{{^locked}}is-open{{/locked}}">
        {{#hasurl}}
          <a class="lp-emp-gate" href="{{url}}">
            <span class="lp-emp-gate-n" aria-hidden="true">{{index}}</span>
            <span class="lp-emp-gate-name">{{name}}</span>
            <span class="lp-chip {{chiptype}}">{{chip}}</span>
          </a>
        {{/hasurl}}
        {{^hasurl}}
          <div class="lp-emp-gate" aria-disabled="true">
            <span class="lp-emp-gate-n" aria-hidden="true">{{index}}</span>
            <span class="lp-emp-gate-name">{{name}}</span>
            <span class="lp-chip {{chiptype}}">{{chip}}</span>
          </div>
        {{/hasurl}}
      </li>
    {{/gates}}
  </ul>
</section>
{{/hasgates}}

<div class="lp-grid-2 lp-reveal" data-region="employer-workspace" style="--lp-d:4">
  <section class="lp-card lift">
    <div class="lp-card-head">
      <h3>{{strings.activities}}</h3>
      {{#hasprimary}}
        <a class="lp-link" href="{{primarycourse.url}}">{{strings.opencourse}} →</a>
      {{/hasprimary}}
    </div>
    <p class="lp-muted lp-sm">{{strings.activitieshelp}}</p>
    {{#activitytotal}}
      <div class="lp-progress-block">
        <div class="lp-progress-meta">
          <b>{{activitypct}}%</b>
          <span class="lp-muted">{{activitydone}} / {{activitytotal}}</span>
        </div>
        <div class="lp-bar" aria-hidden="true"><i style="width:{{activitypct}}%"></i></div>
      </div>
    {{/activitytotal}}
    {{#hasactivities}}
      <ul class="lp-act-list">
        {{#activities}}
          <li class="lp-act{{#complete}} is-done{{/complete}}">
            <span class="lp-chk{{#complete}} on{{/complete}}" aria-hidden="true">{{#complete}}✓{{/complete}}</span>
            <div class="lp-act-meta">
              <span class="lp-act-k">{{modname}}</span>
              <a class="lp-act-t" href="{{url}}">{{name}}</a>
            </div>
          </li>
        {{/activities}}
      </ul>
    {{/hasactivities}}
    {{^hasactivities}}
      <p class="lp-muted">{{strings.noactivities}}</p>
    {{/hasactivities}}
  </section>

  <div class="lp-stack-lg">
    <section class="lp-card lift" id="assigned">
      <div class="lp-card-head">
        <h3>{{strings.assigned}}</h3>
      </div>
      <p class="lp-muted lp-sm">{{strings.tip}}</p>
      <ul class="lp-course-list">
        {{#courses}}
          <li>
            <a class="lp-course-main" href="{{url}}">
              <span class="lp-course-badge">{{badge}}</span>
              <b>{{name}}</b>
              <span class="lp-muted">{{progresslabel}}</span>
              {{#hasprogress}}
                <span class="lp-bar lp-bar-thin" aria-hidden="true"><i style="width:{{progress}}%"></i></span>
              {{/hasprogress}}
            </a>
            <a class="lp-link-sm" href="{{url}}">{{strings.opencourse}}</a>
          </li>
        {{/courses}}
      </ul>
    </section>

    <section class="lp-card lift soft">
      <div class="lp-card-head">
        <h3>{{strings.corelinks}}</h3>
      </div>
      <p class="lp-muted lp-sm">{{strings.corehelp}}</p>
      <div class="lp-core-links lp-core-links-grid">
        <a class="lp-btn lp-btn-light" href="{{urls.mydashboard}}">{{strings.linkdashboard}}</a>
        <a class="lp-btn lp-btn-light" href="{{#hasprimary}}{{urls.coursegrades}}{{/hasprimary}}{{^hasprimary}}{{urls.grades}}{{/hasprimary}}">{{strings.linkgrades}}</a>
        <a class="lp-btn lp-btn-light" href="{{urls.calendar}}">{{strings.linkcalendar}}</a>
        <a class="lp-btn lp-btn-light" href="{{urls.messages}}">{{strings.linkmessages}}</a>
      </div>
    </section>
  </div>
</div>
