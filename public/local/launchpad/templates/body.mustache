<!-- PORTALS -->
<section id="portals"><div class="wrap">
  <div class="sec-head reveal"><div class="l"><span class="eyebrow">Two ways in</span><h2>One Learn account. Two portals.</h2></div>
    <p class="muted" style="max-width:440px">Sign in once with Moodle. Your enrolment decides which portal you see — employer cohort or fellowship programme. The course bar stays the same.</p></div>

  <div class="portal-shared reveal" role="group" aria-label="Shared across both portals">
    <span class="portal-shared-lab">Same on both portals</span>
    <ul>
      <li><iconify-icon icon="hugeicons:book-open-01" width="18" height="18" aria-hidden="true"></iconify-icon><b>Assigned courses only</b><span>No open marketplace</span></li>
      <li><iconify-icon icon="hugeicons:task-01" width="18" height="18" aria-hidden="true"></iconify-icon><b>Four gates</b><span>Foundations → Demo Day</span></li>
      <li><iconify-icon icon="hugeicons:award-01" width="18" height="18" aria-hidden="true"></iconify-icon><b>70 / 100 pass</b><span>Same rubric for every gate</span></li>
      <li><iconify-icon icon="hugeicons:certificate-01" width="18" height="18" aria-hidden="true"></iconify-icon><b>Certificate</b><span>Only when criteria are met</span></li>
    </ul>
  </div>

  <div class="portal-switch reveal" role="tablist" aria-label="Choose portal">
    <button type="button" class="on" role="tab" id="tabEmployer" aria-selected="true" aria-controls="portal-employer" data-portal="employer">
      <iconify-icon icon="hugeicons:building-03" width="18" height="18" aria-hidden="true"></iconify-icon> Employer
    </button>
    <button type="button" role="tab" id="tabFellow" aria-selected="false" aria-controls="portal-fellow" data-portal="fellow">
      <iconify-icon icon="hugeicons:graduation-scroll" width="18" height="18" aria-hidden="true"></iconify-icon> Fellowship
    </button>
  </div>

  <div class="portal-panels">
    <article class="portal-card on" id="portal-employer" role="tabpanel" aria-labelledby="tabEmployer">
      <div class="portal-media">
        <img src="{{{assets}}}/employer-trust.webp" alt="Employer teams learning with structured assigned courses">
        <span class="portal-media-lab"><iconify-icon icon="hugeicons:building-03" width="16" height="16" aria-hidden="true"></iconify-icon> Employer</span>
      </div>
      <div class="portal-content">
        <div class="portal-head">
          <span class="chip">For organisations</span>
          <h3>Employer portal</h3>
          <p class="muted">Upskill assigned employee cohorts with mentor-reviewed evidence — not vanity completion dashboards.</p>
        </div>
        <dl class="portal-facts">
          <div><dt><iconify-icon icon="hugeicons:user-group" width="18" height="18" aria-hidden="true"></iconify-icon> Who it’s for</dt><dd>L&amp;D teams, managers, and employees in a cohort</dd></div>
          <div><dt><iconify-icon icon="hugeicons:bookmark-02" width="18" height="18" aria-hidden="true"></iconify-icon> Who assigns courses</dt><dd>Your employer or programme admin</dd></div>
          <div><dt><iconify-icon icon="hugeicons:view" width="18" height="18" aria-hidden="true"></iconify-icon> After sign-in</dt><dd>Only the tracks assigned to your cohort</dd></div>
          <div><dt><iconify-icon icon="hugeicons:chart-line-data-01" width="18" height="18" aria-hidden="true"></iconify-icon> Progress visibility</dt><dd>Managers see phase status; learners see mentor notes</dd></div>
          <div><dt><iconify-icon icon="hugeicons:flag-01" width="18" height="18" aria-hidden="true"></iconify-icon> Finish line</dt><dd>Capstone reviewed against the published rubric</dd></div>
        </dl>
        <div class="portal-foot">
          {{#loggedin}}
          <a class="btn primary" href="{{{portalurl}}}" data-moodle-portal>Access Employer portal <iconify-icon icon="hugeicons:arrow-right-02" width="16" height="16" aria-hidden="true"></iconify-icon></a>
          <span class="muted portal-note">Opens your dashboard. Employer enrolment controls what you see.</span>
          {{/loggedin}}
          {{^loggedin}}
          <a class="btn primary" href="{{{employeeurl}}}">Sign in to Employer <iconify-icon icon="hugeicons:arrow-right-02" width="16" height="16" aria-hidden="true"></iconify-icon></a>
          <span class="muted portal-note">Opens Moodle login, then the employee area. Access is assigned by your programme admin — no public employee signup.</span>
          {{/loggedin}}
        </div>
      </div>
    </article>

    <article class="portal-card" id="portal-fellow" role="tabpanel" aria-labelledby="tabFellow" hidden>
      <div class="portal-media">
        <img src="{{{assets}}}/fellowship-bridge.webp" alt="Fellowship bridge from campus learning to real craft">
        <span class="portal-media-lab"><iconify-icon icon="hugeicons:graduation-scroll" width="16" height="16" aria-hidden="true"></iconify-icon> Fellowship</span>
      </div>
      <div class="portal-content">
        <div class="portal-head">
          <span class="chip">For colleges &amp; fellows</span>
          <h3>Fellowship portal</h3>
          <p class="muted">Bridge campus to craft — guided projects, labelled simulations, and a Demo Day you can defend.</p>
        </div>
        <dl class="portal-facts">
          <div><dt><iconify-icon icon="hugeicons:user-group" width="18" height="18" aria-hidden="true"></iconify-icon> Who it’s for</dt><dd>College fellows and programme mentors</dd></div>
          <div><dt><iconify-icon icon="hugeicons:bookmark-02" width="18" height="18" aria-hidden="true"></iconify-icon> Who assigns courses</dt><dd>Your college or fellowship programme</dd></div>
          <div><dt><iconify-icon icon="hugeicons:view" width="18" height="18" aria-hidden="true"></iconify-icon> After sign-in</dt><dd>Only the tracks assigned to your cohort</dd></div>
          <div><dt><iconify-icon icon="hugeicons:chart-line-data-01" width="18" height="18" aria-hidden="true"></iconify-icon> Progress visibility</dt><dd>Phase record + mentor change notes before each gate</dd></div>
          <div><dt><iconify-icon icon="hugeicons:flag-01" width="18" height="18" aria-hidden="true"></iconify-icon> Finish line</dt><dd>Demo Day — defend artifacts in the room</dd></div>
        </dl>
        <div class="portal-foot">
          {{#loggedin}}
          <a class="btn primary" href="{{{portalurl}}}" data-moodle-portal>Access Fellowship portal <iconify-icon icon="hugeicons:arrow-right-02" width="16" height="16" aria-hidden="true"></iconify-icon></a>
          <span class="muted portal-note">Opens your dashboard. Fellowship enrolment controls what you see.</span>
          {{/loggedin}}
          {{^loggedin}}
          {{#cansignup}}
          <a class="btn primary" href="{{{signupurl}}}">{{strregisterfellowship}} <iconify-icon icon="hugeicons:arrow-right-02" width="16" height="16" aria-hidden="true"></iconify-icon></a>
          <a class="btn light" href="{{{loginurl}}}?portal=fellowship" data-moodle-login>{{strsigninfellowship}}</a>
          <span class="muted portal-note">{{strsignupconfirmnote}}</span>
          {{/cansignup}}
          {{^cansignup}}
          <a class="btn primary" href="{{{loginurl}}}?portal=fellowship" data-moodle-login>{{strsigninfellowship}} <iconify-icon icon="hugeicons:arrow-right-02" width="16" height="16" aria-hidden="true"></iconify-icon></a>
          <span class="muted portal-note">{{strsignupclosednote}}</span>
          {{/cansignup}}
          {{/loggedin}}
        </div>
      </div>
    </article>
  </div>
</div></section>

<!-- COURSES HIGHLIGHT -->
