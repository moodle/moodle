    <span class="course-rules-lab">True for every track</span>
    <ul>
      <li><iconify-icon icon="hugeicons:bookmark-02" width="18" height="18" aria-hidden="true"></iconify-icon><b>Assigned only</b><span>Admin assigns; no marketplace</span></li>
      <li><iconify-icon icon="hugeicons:task-01" width="18" height="18" aria-hidden="true"></iconify-icon><b>Four gates</b><span>Foundations to Demo Day</span></li>
      <li><iconify-icon icon="hugeicons:award-01" width="18" height="18" aria-hidden="true"></iconify-icon><b>Pass bar</b><span>70 / 100 each gate</span></li>
      <li><iconify-icon icon="hugeicons:flag-01" width="18" height="18" aria-hidden="true"></iconify-icon><b>Finish line</b><span>Demo Day defense</span></li>
    </ul>
  </div>

  <div class="course-list" id="trackRow" aria-label="Programme tracks"></div>

  <div class="finder reveal" id="finder">
