{{!
    @template local_launchpad/employer_empty

    Empty employer home — same lp-empty treatment as Fellowship, plus locked journey spine.
}}
<div class="lp-empty" role="status" data-region="employer-empty">
  <div class="lp-empty-mark" aria-hidden="true">EM</div>
  <h2>{{strings.welcome}}</h2>
  <p>{{empty.body}}</p>
  <div class="lp-empty-actions">
    <a class="lp-btn lp-btn-primary" href="{{urls.mycourses}}">{{strings.mycourses}}</a>
    <a class="lp-btn lp-btn-light" href="{{urls.profile}}">{{strings.linkprofile}}</a>
    <a class="lp-btn lp-btn-light" href="{{urls.calendar}}">{{strings.linkcalendar}}</a>
  </div>
</div>

{{#journey.has_gates}}
<section class="lp-card lift lp-journey-card" data-region="employer-journey">
  <div class="lp-card-head">
    <h2 class="lp-journey-title">{{strings.journey}}</h2>
  </div>
  <p class="lp-muted lp-sm">{{strings.journeyhelp}}</p>
  <div class="lp-journey{{#journey.compact}} compact{{/journey.compact}}" data-lp-journey>
    <div class="lp-journey-in">
      <svg viewBox="0 0 1000 {{journey.view_h}}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="{{strings.journey}}">
        <path d="{{journey.path_d}}" fill="none" stroke="var(--lp-blue-soft)" stroke-width="14" stroke-linecap="round"/>
        <path class="lp-journey-progress" d="{{journey.path_d}}" fill="none" stroke="var(--lp-blue)" stroke-width="14" stroke-linecap="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" data-to="{{journey.dash_offset}}"/>
        <path d="{{journey.path_d}}" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="2 14" stroke-linecap="round" opacity=".7"/>
        {{#journey.gates}}
          <g class="lp-jn {{status}}" transform="translate({{cx}},{{cy}})">
            <title>{{name}}</title>
            <circle r="{{ring_r}}" class="ring"/>
            <circle r="{{core_r}}" class="core"/>
            <text y="{{mark_y}}" text-anchor="middle">{{mark}}</text>
            <text class="lb" y="{{label_y}}" text-anchor="middle">{{short}}</text>
          </g>
        {{/journey.gates}}
      </svg>
      {{#bot_url}}
        <img class="lp-jbot" src="{{bot_url}}" alt="" style="left:{{journey.bot_left}};top:{{journey.bot_top}}">
      {{/bot_url}}
    </div>
  </div>
</section>
{{/journey.has_gates}}
