{{!
    @template local_launchpad/employer_empty

    Empty employer home — polished empty state + Moodle tools (no invented journey).
}}
<div class="lp-empty lp-reveal" role="status" data-region="employer-empty" style="--lp-d:0">
  <div class="lp-empty-mark" aria-hidden="true">EM</div>
  <h2>{{empty.title}}</h2>
  <p>{{empty.body}}</p>
  <div class="lp-empty-actions">
    <a class="lp-btn lp-btn-primary" href="{{urls.calendar}}">{{strings.linkcalendar}}</a>
    <a class="lp-btn lp-btn-light" href="{{urls.messages}}">{{strings.linkmessages}}</a>
    <a class="lp-btn lp-btn-light" href="{{urls.profile}}">{{strings.linkprofile}}</a>
  </div>
</div>

{{#hastiles}}
<ul class="lp-tiles lp-reveal" aria-label="{{strings.overview}}" style="--lp-d:1">
  {{#tiles}}
    <li class="lp-tile" data-icon="{{icon}}">
      <span class="lp-tile-ico" aria-hidden="true"></span>
      <div class="lp-tile-text">
        <span class="lp-tile-label">{{label}}</span>
        <b class="lp-tile-value">{{value}}</b>
        <span class="lp-tile-sub">{{sub}}</span>
      </div>
    </li>
  {{/tiles}}
</ul>
{{/hastiles}}

<section class="lp-card lift soft lp-reveal" style="--lp-d:2">
  <div class="lp-card-head">
    <h3>{{strings.corelinks}}</h3>
  </div>
  <p class="lp-muted lp-sm">{{strings.corehelp}}</p>
  <div class="lp-core-links lp-core-links-grid">
    <a class="lp-btn lp-btn-light" href="{{urls.mydashboard}}">{{strings.linkdashboard}}</a>
    <a class="lp-btn lp-btn-light" href="{{urls.grades}}">{{strings.linkgrades}}</a>
    <a class="lp-btn lp-btn-light" href="{{urls.calendar}}">{{strings.linkcalendar}}</a>
    <a class="lp-btn lp-btn-light" href="{{urls.messages}}">{{strings.linkmessages}}</a>
  </div>
</section>
