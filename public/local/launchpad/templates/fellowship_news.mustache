{{!
    @template local_launchpad/fellowship_news
}}
{{#has_crumbs}}
  <nav class="lp-crumbs" aria-label="{{#str}} fellowship_breadcrumb, local_launchpad {{/str}}">
    {{#crumbs}}
      {{#url}}<a href="{{url}}">{{label}}</a><span aria-hidden="true">/</span>{{/url}}
      {{^url}}<span aria-current="page">{{label}}</span>{{/url}}
    {{/crumbs}}
  </nav>
{{/has_crumbs}}

<div class="lp-ach-head">
  <div class="lp-row-sb">
    <div>
      <span class="lp-eyebrow">{{#str}} fellowship_nav_you, local_launchpad {{/str}}</span>
      <h2>{{#str}} fellowship_nav_news, local_launchpad {{/str}}</h2>
      <p class="lp-muted">{{#str}} fellowship_news_intro, local_launchpad {{/str}}</p>
    </div>
    <a class="lp-btn lp-btn-light" href="{{moodle_news_url}}">{{#str}} fellowship_news_open_moodle, local_launchpad {{/str}}</a>
  </div>
</div>

{{#has_items}}
  <div class="lp-stack">
    {{#items}}
      <article class="lp-card lift lp-news-item">
        <div class="lp-row-sb">
          <span class="lp-eyebrow">{{{course_name}}}</span>
          <span class="lp-xs lp-muted">{{when}}</span>
        </div>
        <h3><a href="{{url}}">{{{subject}}}</a></h3>
        {{#author}}<p class="lp-sm lp-muted">{{author}}</p>{{/author}}
        <div class="lp-sm">{{{excerpt}}}</div>
      </article>
    {{/items}}
  </div>
{{/has_items}}
{{^has_items}}
  <div class="lp-empty" role="status">
    <div class="lp-empty-mark" aria-hidden="true">··</div>
    <h2>{{#str}} fellowship_news_empty_title, local_launchpad {{/str}}</h2>
    <p>{{#str}} fellowship_news_empty_body, local_launchpad {{/str}}</p>
  </div>
{{/has_items}}
