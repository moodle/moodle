{{!
    @template local_launchpad/employer_dashboard

    Employer portal shell: skip → sidebar → topbar → main → orbit.
}}
<a class="lp-skip" href="#lp-main">{{strings.skiptomain}}</a>
<div class="lp-shell" data-region="{{dataregion}}" id="lp-shell">
  <div class="lp-scrim" data-lp-nav-close hidden></div>
  {{> local_launchpad/employer_nav }}

  <div class="lp-main-wrap">
    <header class="lp-topbar">
      <div class="lp-topbar-start">
        <button type="button" class="lp-menu-btn" data-lp-nav-toggle aria-expanded="false" aria-controls="lp-side">
          <iconify-icon icon="hugeicons:menu-01" width="18" height="18" aria-hidden="true"></iconify-icon>
          {{strings.menu}}
        </button>
        <div class="lp-greet">
          <h1 class="lp-page-title">{{#is_home}}{{greeting}}{{/is_home}}{{^is_home}}{{pagetitle}}{{/is_home}}</h1>
          <p class="lp-greet-sub">{{portallabel}}</p>
        </div>
      </div>
      <div class="lp-topbar-actions">
        {{#hascourses}}
          <a class="lp-xp-chip" href="{{sidecard.url}}" title="{{sidecard.title}}">
            <iconify-icon icon="hugeicons:chart-line-data-01" width="16" height="16" aria-hidden="true"></iconify-icon>
            <b>{{sidecard.chip_value}}</b> <span>{{sidecard.chip_label}}</span>
          </a>
        {{/hascourses}}
        <a class="lp-iconbtn" href="{{urls.notifications}}" aria-label="{{notifications_label}}">
          <iconify-icon icon="hugeicons:notification-01" width="18" height="18" aria-hidden="true"></iconify-icon>
          {{#hasunread}}<span class="lp-notif-dot">{{unread}}</span>{{/hasunread}}
        </a>
        <a class="lp-profile-icon" href="{{urls.profile}}" aria-label="{{strings.linkprofile}}" title="{{strings.linkprofile}}">
          <span class="lp-av lp-av-sm" aria-hidden="true">{{initials}}</span>
        </a>
      </div>
    </header>

    <main class="lp-main" id="lp-main" tabindex="-1">
      <div class="lp-inner{{^hascourses}}{{#is_home}} lp-inner-empty{{/is_home}}{{/hascourses}}">
        {{#is_home}}
          {{#hascourses}}
            {{> local_launchpad/employer_home }}
          {{/hascourses}}
          {{^hascourses}}
            {{> local_launchpad/employer_empty }}
          {{/hascourses}}
        {{/is_home}}
        {{#is_courses}}
          {{> local_launchpad/employer_courses }}
        {{/is_courses}}
        {{#is_course}}
          {{> local_launchpad/employer_course_detail }}
        {{/is_course}}
        {{#is_activity}}
          {{> local_launchpad/employer_activity }}
        {{/is_activity}}
      </div>
    </main>
  </div>
</div>

{{#bot_url}}
<div class="lp-orbit" id="lp-orbit" data-lp-orbit>
  <div class="lp-orbit-say{{^orbit_tip}} is-hide{{/orbit_tip}}" id="lp-orbit-say" role="status">
    <span class="lp-orbit-say-text">{{{orbit_tip}}}</span>
    <button type="button" class="lp-orbit-say-x" data-lp-orbit-dismiss aria-label="{{strings.orbitdismiss}}">×</button>
  </div>
  <button type="button" class="lp-orbit-botbtn" data-lp-orbit-hop aria-label="{{strings.orbitaria}}">
    <img class="lp-orbit-bot" src="{{bot_url}}" alt="">
  </button>
</div>
<button type="button" class="lp-orbit-hide" data-lp-orbit-hide>{{strings.orbithide}}</button>
{{/bot_url}}
