{{!
    @template local_launchpad/fellowship_phases

    Phase progress — full journey + weight/score/status from Moodle assign grades.
}}
{{#has_crumbs}}
  <nav class="lp-crumbs" aria-label="{{#str}} fellowship_breadcrumb, local_launchpad {{/str}}">
    {{#crumbs}}
      {{#url}}<a href="{{url}}">{{label}}</a><span aria-hidden="true">/</span>{{/url}}
      {{^url}}<span aria-current="page">{{label}}</span>{{/url}}
    {{/crumbs}}
  </nav>
{{/has_crumbs}}

<div class="lp-ach-head">
  <span class="lp-eyebrow">{{#str}} fellowship_phases_eyebrow, local_launchpad {{/str}}</span>
  <h2>{{#str}} fellowship_nav_phases, local_launchpad {{/str}}</h2>
  <p class="lp-muted">{{#str}} fellowship_phases_lead, local_launchpad {{/str}}</p>
</div>

{{^has_course}}
  <div class="lp-empty" role="status">
    <div class="lp-empty-mark" aria-hidden="true">LP</div>
    <h2>{{#str}} fellowship_nav_phases, local_launchpad {{/str}}</h2>
    <p>{{empty_message}}</p>
  </div>
{{/has_course}}

{{#has_course}}
  <section class="lp-card lift lp-journey-card">
    {{> local_launchpad/fellowship_journey}}
  </section>

  <div class="lp-stack lp-phase-list">
    {{#phases}}
      <div class="lp-phase-item">
        <div class="lp-phase-ico{{#ico_dim}} dim{{/ico_dim}}" aria-hidden="true">{{ico}}</div>
        <div class="lp-phase-bd">
          <b>{{name}}</b>
          <small>{{#str}} fellowship_phase_weight, local_launchpad {{/str}} {{weight_label}} · {{hint}}</small>
        </div>
        <span class="lp-num lp-phase-score">{{score_display}}</span>
        {{#has_chip_class}}
          <span class="lp-chip {{chip}}">{{status}}</span>
        {{/has_chip_class}}
        {{^has_chip_class}}
          <span class="lp-chip">{{status}}</span>
        {{/has_chip_class}}
      </div>
    {{/phases}}
  </div>

  <p class="lp-note lp-muted">{{#str}} fellowship_phases_note, local_launchpad {{/str}}</p>
{{/has_course}}
