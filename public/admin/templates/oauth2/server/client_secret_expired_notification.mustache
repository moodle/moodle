    @template core_admin/oauth2/server/client_secret_expired_notification
    @summary Renders a notification about an expired client secret.

    Context variables required for this template:
    * clientname - The name of the OAuth2 client associated to the expired secret.
    * secretexpireddatetime - The date and time when the secret expired.
    * managesecretsurl - The manage secrets URL for the OAuth2 client associated to the expired secret.

    Example context (json):
    {
        "clientname": "Example Client",
        "secretexpireddatetime": "08 October 2026, 04:30 PM",
        "managesecretsurl": "https://example.com/admin/oauth2/clients.php"
    }
}}
<p>{{#str}} oauth2server_secretexpirednotificationintro, admin, {"clientname": "{{clientname}}", "secretexpireddatetime": "{{secretexpireddatetime}}"} {{/str}}</p>
<p>{{#str}} oauth2server_secretexpirednotificationdesc, admin {{/str}}</p>
<p>{{#str}} oauth2server_secretexpirednotificationaction, admin, {{managesecretsurl}} {{/str}}</p>
