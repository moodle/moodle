    @template core_admin/oauth2/server/edit_client
    @summary Renders the content of the OAuth2 client edit page.

    Context variables required for this template:
    * title - The title of the page (client's name).
    * clientidentifier - The public client identifier.
    * isactive - Whether the client is active.
    * isconfidential - Whether the client is confidential.
    * isauthcodesupported - Whether the client supports the authorization code flow.
    * isclientcredentialssupported - Whether the client supports the client credentials flow.
    * backurl - The URL to return to the clients list.
    * editclientform - The rendered form for editing the client.
    * activesecretscount - The number of active secrets for the client.
    * managesecretsurl - The URL to manage the client's secrets.

    Example context (json):
    {
        "title": "Community mobile app",
        "clientidentifier": "4c7a2e9f1d6b0835",
        "isactive": true,
        "isconfidential": true,
        "isauthcodesupported": true,
        "isclientcredentialssupported": true,
        "backurl": "/admin/oauth2/clients.php",
        "editclientform": "<form>...</form>",
        "activesecretscount": 0,
        "managesecretsurl": "http://example.com/admin/oauth2server/clients/1/secrets"
    }
}}
<div class="oauth2-client-header mb-4">
    {{>core_admin/oauth2/server/client_heading}}
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 {{#isconfidential}} {{#isactive}} row-cols-lg-5 {{/isactive}} {{/isconfidential}} g-3 w-100 mb-4">
        <!-- Status card -->
        <div class="col">
            <div id="client-status" class="p-3 border rounded bg-light h-100" role="group" aria-labelledby="client-status-label">
                <span id="client-status-label" class="text-body-secondary small d-block mb-1">
                    {{#str}} status, core {{/str}}
                </span>
                <div>
                    {{#isactive}}
                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2 py-1">
                            {{#str}} oauth2server_statusactive, admin {{/str}}
                        </span>
                    {{/isactive}}
                    {{^isactive}}
                        <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-2 py-1">
                            {{#str}} oauth2server_statusrevoked, admin {{/str}}
                        </span>
                    {{/isactive}}
                </div>
            </div>
        </div>
        <!-- Type card -->
        <div class="col">
            <div id="client-type" class="p-3 border rounded bg-light h-100" role="group" aria-labelledby="client-type-label">
                <span id="client-type-label" class="text-body-secondary small d-block mb-1">
                    {{#str}} oauth2server_clienttype, admin {{/str}}
                </span>
                <div>
                    <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-2 py-1">
                        {{#isconfidential}}
                            {{#str}} oauth2server_clienttypeconfidential, admin {{/str}}
                        {{/isconfidential}}
                        {{^isconfidential}}
                            {{#str}} oauth2server_clienttypepublic, admin {{/str}}
                        {{/isconfidential}}
                    </span>
                </div>
            </div>
        </div>
        <!-- Primary Flow card -->
        <div class="col">
            <div id="client-flows" class="p-3 border rounded bg-light h-100" role="group" aria-labelledby="client-flow-label">
                <span id="client-flow-label" class="text-body-secondary small d-block mb-1">
                    {{#str}} oauth2server_clientprimaryflows, admin {{/str}}
                </span>
                <div>
                    {{#isauthcodesupported}}
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2 py-1 fw-bold">
                            {{#str}} oauth2server_clientgranttypeauthcode, admin {{/str}}
                        </span>
                    {{/isauthcodesupported}}
                    {{#isclientcredentialssupported}}
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2 py-1 fw-bold">
                            {{#str}} oauth2server_clientgranttypeclientcreds, admin {{/str}}
                        </span>
                    {{/isclientcredentialssupported}}
                </div>
            </div>
        </div>
        <!-- Client ID card -->
        <div class="col">
            <div id="client-id" class="p-3 border rounded bg-light h-100" role="group" aria-labelledby="client-id-label">
                <span id="client-id-label" class="text-body-secondary small d-block mb-1">
                    {{#str}} oauth2server_clientid, admin {{/str}}
                </span>
                <div>
                    <code class="user-select-all text-break">{{clientidentifier}}</code>
                </div>
            </div>
        </div>
        {{#isconfidential}}
            {{#isactive}}
                <!-- Active secrets card -->
                <div class="col">
                    <div id="client-active-secrets" class="p-3 border rounded bg-light h-100" role="group" aria-labelledby="active-secrets-id-label">
                        <span id="active-secrets-id-label" class="text-body-secondary small d-block mb-1">
                            {{#str}} oauth2server_activesecrets, admin {{/str}}
                        </span>
                        <div class="d-flex align-items-center">
                            <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-2 py-1">
                                {{activesecretscount}}
                            </span>
                            <a href="{{managesecretsurl}}" class="small ms-auto">
                                {{#str}} oauth2server_managesecrets, admin {{/str}}
                            </a>
                        </div>
                    </div>
                </div>
            {{/isactive}}
        {{/isconfidential}}
    </div>
    <div data-region="client-details" class="mt-5">
        <h3 class="fs-4 fw-bold mb-2"> {{#str}} details, core {{/str}}</h3>
        {{{editclientform}}}
    </div>
</div>
