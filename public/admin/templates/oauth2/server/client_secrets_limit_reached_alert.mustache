    @template core_admin/oauth2/server/client_secrets_limit_reached_alert
    @summary Alert shown when the client secrets limit has been reached.

    Context variables required for this template:
    * maxsecretsnumber - The maximum number of active secrets allowed for the client.

    Example context (json):
    {
        "maxsecretsnumber": 2
    }
}}
<div id="client-secrets-limit-reached-alert" class="alert alert-info">
    <i class="fa fa-circle-info me-2"></i>
    <span class="alert-text">
        {{#str}} oauth2server_clientsecretslimitreached, admin, {{maxsecretsnumber}} {{/str}}
    </span>
</div>