{{!
    @template tool_mobile/feature_animation_logo

    Embedded logo preview animation for system setting alerts.

    Context variables required for this template:
    * none

    Example context (json):
    {}
}}
<div class="tool-mobile-logo-preview" aria-hidden="true">
    <div class="tool-mobile-logo-preview-phone">
        <div class="tool-mobile-logo-preview-statusbar">
            <div class="tool-mobile-logo-preview-notch"></div>
            <div class="tool-mobile-logo-preview-statusicons">
                <span class="tool-mobile-logo-preview-statusicon tool-mobile-logo-preview-statusicon-signal"></span>
                <span class="tool-mobile-logo-preview-statusicon tool-mobile-logo-preview-statusicon-wifi"></span>
                <span class="tool-mobile-logo-preview-statusicon tool-mobile-logo-preview-statusicon-battery"></span>
            </div>
        </div>

        <div class="tool-mobile-logo-preview-navrow">
            <div class="tool-mobile-logo-preview-navleft">
                <i class="fa-solid fa-chevron-left tool-mobile-logo-preview-backarrow" aria-hidden="true"></i>
                <div class="tool-mobile-logo-preview-navpill"></div>
            </div>
            <div class="tool-mobile-logo-preview-navicons">
                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                <i class="fa-regular fa-circle-question" aria-hidden="true"></i>
            </div>
        </div>

        <div class="tool-mobile-logo-preview-logowrap">
            <div class="tool-mobile-logo-preview-logotile">
                <div class="tool-mobile-logo-preview-brand tool-mobile-logo-preview-brand-a">
                    <div class="tool-mobile-logo-preview-mountain"></div>
                </div>
                <div class="tool-mobile-logo-preview-brand tool-mobile-logo-preview-brand-b">
                    <div class="tool-mobile-logo-preview-flower">
                        <div class="tool-mobile-logo-preview-petal"></div>
                        <div class="tool-mobile-logo-preview-petal"></div>
                        <div class="tool-mobile-logo-preview-petal"></div>
                        <div class="tool-mobile-logo-preview-petal"></div>
                        <div class="tool-mobile-logo-preview-flowercentre"></div>
                    </div>
                </div>
                <div class="tool-mobile-logo-preview-brand tool-mobile-logo-preview-brand-c">
                    <div class="tool-mobile-logo-preview-orbit"></div>
                </div>
            </div>
        </div>

        <div class="tool-mobile-logo-preview-titles">
            <div class="tool-mobile-logo-preview-titlepill"></div>
            <div class="tool-mobile-logo-preview-titlepill tool-mobile-logo-preview-titlepill-secondary"></div>
        </div>

        <div class="tool-mobile-logo-preview-form">
            <div class="tool-mobile-logo-preview-field">
                <div class="tool-mobile-logo-preview-fieldhint"></div>
            </div>
            <div class="tool-mobile-logo-preview-field">
                <div class="tool-mobile-logo-preview-fieldhint tool-mobile-logo-preview-fieldhint-short"></div>
                <i class="fa-solid fa-eye tool-mobile-logo-preview-eye" aria-hidden="true"></i>
            </div>
            <div class="tool-mobile-logo-preview-loginbtn">
                <div class="tool-mobile-logo-preview-btnlabel"></div>
            </div>
        </div>
    </div>
</div>