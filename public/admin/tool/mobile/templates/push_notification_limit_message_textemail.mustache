{{!
    @template tool_mobile/push_notification_limit_message_textemail

    Plain text email template for the push notification limit alert.

    Context variables required for this template:
    * heading
    * messagegreeting
    * missedusers
    * metriclabel
    * ratiolabel
    * footer
    * learnmoreplan

    Example context (json):
    {
        "heading": "Your monthly device limit for push notifications has been reached",
        "messagegreeting": "You're receiving this notification because you're an administrator of Example site.",
        "missedusers": "15 users have stopped receiving push notifications this month.",
        "metriclabel": "Active devices for push notifications",
        "ratiolabel": "60 / 50",
        "footer": "New devices added over the limit will not receive push notifications.",
        "learnmoreplan": "To learn more about the Moodle app and its plans, see the Moodle app plans documentation [https://docs.moodle.org/en/Moodle_app_plans]"
    }
}}
{{{messagegreeting}}}

{{heading}}

{{missedusers}}

{{metriclabel}}: {{ratiolabel}}

{{footer}}

{{{learnmoreplan}}}