{{!
    @template tool_mobile/feature_animation_custom

    Embedded branding preview for the customisation animation.

    Context variables required for this template:
    * none

    Example context (json):
    {}
}}

<div class="tool-mobile-branding-preview" aria-hidden="true">
    <div class="tool-mobile-branding-preview-scene">
        <div class="tool-mobile-branding-preview-picker">
            <div class="tool-mobile-branding-preview-row">
                <div class="tool-mobile-branding-preview-pill tool-mobile-branding-preview-pill-wide"></div>
                <div class="tool-mobile-branding-preview-dot"></div>
            </div>
            <div class="tool-mobile-branding-preview-swatches">
                <div class="tool-mobile-branding-preview-swatch tool-mobile-branding-preview-swatch-a"></div>
                <div class="tool-mobile-branding-preview-swatch tool-mobile-branding-preview-swatch-b"></div>
                <div class="tool-mobile-branding-preview-swatch tool-mobile-branding-preview-swatch-c"></div>
            </div>
            <div class="tool-mobile-branding-preview-gradient">
                <div class="tool-mobile-branding-preview-cursor"></div>
            </div>
            <div class="tool-mobile-branding-preview-row">
                <div class="tool-mobile-branding-preview-pill tool-mobile-branding-preview-pill-mid"></div>
                <div class="tool-mobile-branding-preview-pill tool-mobile-branding-preview-pill-small"></div>
            </div>
        </div>

        <div class="tool-mobile-branding-preview-phone">
            <div class="tool-mobile-branding-preview-header">
                <div class="tool-mobile-branding-preview-header-pill"></div>
                <div class="tool-mobile-branding-preview-header-dot"></div>
            </div>
            <div class="tool-mobile-branding-preview-list">
                <div class="tool-mobile-branding-preview-card">
                    <div class="tool-mobile-branding-preview-card-pill"></div>
                    <div class="tool-mobile-branding-preview-card-pill tool-mobile-branding-preview-card-pill-secondary"></div>
                    <div class="tool-mobile-branding-preview-bar"></div>
                </div>
                <div class="tool-mobile-branding-preview-card">
                    <div class="tool-mobile-branding-preview-card-pill tool-mobile-branding-preview-card-pill-short"></div>
                    <div class="tool-mobile-branding-preview-card-pill tool-mobile-branding-preview-card-pill-secondary tool-mobile-branding-preview-card-pill-secondary-short"></div>
                    <div class="tool-mobile-branding-preview-bar tool-mobile-branding-preview-bar-short"></div>
                </div>
            </div>
            <div class="tool-mobile-branding-preview-button">
                <div class="tool-mobile-branding-preview-button-label"></div>
            </div>
        </div>
    </div>
</div>