{{!
    @template core_question/bulk_actions_ui

    Example context (json):
    {
        "bulkactionitems": [
            {
                "actionname": "Move to",
                "actionkey": "move",
                "actionurl": "/question/bank/bulkmove/move.php?courseid=2",
                "icon": "i/move_2d"
            },
            {
                "actionname": "Delete",
                "actionkey": "delete",
                "actionurl": "/question/bank/deletequestion/delete.php",
                "actionclasses": "text-danger",
                "icon": "i/delete"
            }
        ]
    }
}}
<div class="bulkenabled">
{{< core/sticky_footer }}
    {{$ stickyclasses }} justify-content-center bulkactions{{/ stickyclasses }}
    {{$ extradata }} data-for="bulkedittools" {{/ extradata }}
    {{$ stickycontent }}
    <div class="btn-group dropup mt-2 d-flex align-items-center" id="bulkactionsui-container">
        <span class="ma-1">{{#str}} withselected, question{{/str}}</span>
        <ul class="actions nav flex-nowrap" data-for="bulkactions">
            {{#bulkactionitems}}
                <li class="nav-item">
                    <button
                        class="btn py-0 d-flex flex-column {{actionclasses}}"
                        type="submit" value="{{actionname}}"
                        name="{{actionkey}}"
                        data-action="toggle"
                        data-togglegroup="qbank"
                        data-toggle="action"
                        form="questionsubmit"
                        formaction="{{{actionurl}}}"
                        disabled="disabled"
                        {{#title}} title="{{title}}" {{/title}}
                    >
                        <span class="bulkaction-icon w-100 ps-2">{{#pix}}{{icon}}{{/pix}}</span>
                        <span class="bulkaction-name">{{actionname}}</span>
                    </button>
                </li>
            {{/bulkactionitems}}
        </ul>
    </div>
    {{/ stickycontent }}
{{/ core/sticky_footer }}
</div>
