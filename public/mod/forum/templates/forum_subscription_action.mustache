{{!
    @template mod_forum/forum_subscription_action
    Actions bar for the subscribers page UI.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * data-region
    Context variables required for this template:
    * see mod/forum/classes/output/subscription_actionbar.php
    * subscriptionoptions - core/url_select data for the subscription mode selector.
    * viewandmanageselectmenu - core/select_menu data for the view and manage subscribers selector.
    * viewandmanageselect - Deprecated since Moodle 5.3, use viewandmanageselectmenu instead.
      core/url_select data for the view and manage subscribers selector. Not used by this template.
      @todo: MDL-89964 Final deprecation on Moodle 7.0.
    Example context (json):
    {
        "subscriptionoptions": {
            "formid": "selectsubscriptions",
            "classes": "urlselect float-end",
            "disabled": false,
            "sesskey": "abcdef",
            "action": "http://localhost/course/jumpto.php",
            "helpicon": false,
            "options": [
                {
                    "name": "Subscription disabled",
                    "value": ""
                },
                {
                    "name": "Optional subscrition",
                    "value": "/mod/forum/subscribe.php?id=3&mode=0&sesskey=abc123"
                }
            ]
        },
        "viewandmanageselectmenu": {
            "name": "selectviewandmanagesubscribers",
            "value": "/mod/forum/subscribers.php?id=3&edit=off",
            "baseid": "select-menu56789",
            "label": "Subscribers",
            "labelattributes": [{"name": "class", "value": "accesshide"}],
            "selectedoption": "View subscribers",
            "inlinelabel": false,
            "disableactive": false,
            "options": [
                {
                    "name": "View subscribers",
                    "value": "/mod/forum/subscribers.php?id=3&edit=off",
                    "selected": true,
                    "id": "select-menu-option1",
                    "disableactive": false
                },
                {
                    "name": "Manage subscribers",
                    "value": "/mod/forum/subscribers.php?id=3&edit=on",
                    "selected": false,
                    "id": "select-menu-option2",
                    "disableactive": false
                }
            ]
        }
    }
}}
<div class="container-fluid tertiary-navigation">
    <div class="d-flex">
        {{#viewandmanageselectmenu}}
            <div class="navitem">
                {{>core/tertiary_navigation_selector}}
            </div>
        {{/viewandmanageselectmenu}}
        {{#subscriptionoptions}}
            <div class="navitem ms-sm-auto">
                {{>core/url_select}}
            </div>
        {{/subscriptionoptions}}
    </div>
</div>
<br>
