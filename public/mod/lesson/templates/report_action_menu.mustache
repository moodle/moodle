{{!
    @template mod_lesson/report_action_menu

    Navigation element for different reports.

    Classes required for JS:
    * none

    Context variables required for this template:
    * see mod/lesson/classes/output/report_action_menu.php

    Example context (json):
    {
        "navigation": {
            "name": "lesson-report-select",
            "value": "/mod/lesson/report.php?id=55&action=reportdetail",
            "baseid": "select-menu56789",
            "label": "Select report",
            "labelattributes": [
                {
                    "name": "class",
                    "value": "accesshide"
                }
            ],
            "selectedoption": "Detailed statistics",
            "options": [
                {
                    "name": "Overview",
                    "value": "/mod/lesson/report.php?id=55&action=reportoverview",
                    "id": "select-menu-option1",
                    "selected": false
                },
                {
                    "name": "Detailed statistics",
                    "value": "/mod/lesson/report.php?id=55&action=reportdetail",
                    "id": "select-menu-option2",
                    "selected": true
                }
            ]
        }
    }
}}
<div class="tertiary-navigation">
    <div class="d-flex">
        {{#navigation}}
            <div class="navitem">
                {{>core/tertiary_navigation_selector}}
            </div>
        {{/navigation}}
    </div>
</div>
