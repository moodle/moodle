{{!
    @template mod_assign/override_actionmenu

    A select menu and button for user and group overrides.

    Classes required for JS:
    * none

    Context variables required for this template:
    * see mod/assign/classes/output/override_actionmenu.php

    Example context (json):
    {
        "navigation": {
            "name": "mod_assign_override_select",
            "value": "/mod/assign/overrides.php?cmid=55&mode=user",
            "baseid": "select-menu56789",
            "label": "Overrides",
            "labelattributes": [
                {
                    "name": "class",
                    "value": "visually-hidden"
                }
            ],
            "selectedoption": "User overrides",
            "options": [
                {
                    "name": "User overrides",
                    "value": "/mod/assign/overrides.php?cmid=55&mode=user",
                    "id": "select-menu-option1",
                    "selected": true
                },
                {
                    "name": "Group overrides",
                    "value": "/mod/assign/overrides.php?cmid=55&mode=group",
                    "id": "select-menu-option2",
                    "selected": false
                }
            ]
        },
        "headinglevel": 2,
        "addoverridebutton": {
            "method": "get",
            "url": "/mod/assign/overrideedit.php?cmid=55&action=adduser",
            "formid": "single_button1",
            "primary": true,
            "label": "Add user override",
            "disabled": false
        }
    }
}}
<div class="tertiary-navigation">
    <div class="d-flex">
        {{#navigation}}
            <div class="navitem">
                {{>core/tertiary_navigation_selector}}
            </div>
        {{/navigation}}
        {{#addoverridebutton}}
            <div class="navitem">
                {{>core/single_button}}
            </div>
        {{/addoverridebutton}}
    </div>
</div>
