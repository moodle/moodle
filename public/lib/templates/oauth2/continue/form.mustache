{{!
    @template core/oauth2/continue/form

    TODO describe template form

    Example context (json):
    {
    }
}}
<div class="d-flex d-inline p-2">
    <form method="POST" action="{{actionurl}}" class="w-50 m-1">
        <input type="hidden" name="sesskey" value="{{sesskey}}"/>
        <input type="hidden" name="currentuser" value="1"/>
        <button type="submit" name="approve" value="1" class="btn btn-primary w-100">{{#str}} oauth2:contineasuser, core, {{userinfo.fullname}} {{/str}}</button>
    </form>

    <form method="POST" action="{{logouturl}}" class="w-50 m-1">
        <input type="hidden" name="sesskey" value="{{sesskey}}"/>
        <input type="hidden" name="currentuser" value="1"/>
        <button type="submit" name="approve" value="1" class="btn btn-primary w-100">{{#str}} oauth2:contineasuser:changeuser, core {{/str}}</button>
    </form>
</div>
