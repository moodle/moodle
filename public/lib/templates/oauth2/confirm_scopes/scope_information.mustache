{{!
    @template core/oauth2/confirm_scopes/scope_information

    Lists the scopes an OAuth2 client is requesting, and any scopes already granted to it, along
    with a reminder to trust the client and a link to the user's account.

    Context variables required for this template:
    * client - The OAuth2 client
      * name - The client's name.
    * sitename - Name of the site,
    * userinfo - Information about the current user
      * profileurl - URL of the user's profile page.
    * requestedscopes - The scopes being requested, each with:
      * summary - A short summary of the scope,
      * description - A longer description of the scope.
    * grantedscopes - The scopes already granted to this client, in the same shape as
      requestedscopes.

    Example context (json):
    {
        "client": {
            "name": "Example client"
        },
        "sitename": "My Moodle Site",
        "userinfo": {
            "profileurl": "https://example.com/moodle/user/profile.php?id=2"
        },
        "requestedscopes": [
            {
                "summary": "View your profile",
                "description": "Allows the application to view your public profile information."
            }
        ],
        "grantedscopes": [
            {
                "summary": "View your courses",
                "description": "Allows the application to see which courses you are enrolled in."
            }
        ]
    }
}}
<h2 class="h4">
    {{#str}}oauth2:confirmscopes:beforelist, moodle, {
        "clientname": {{#quote}}{{client.name}}{{/quote}},
        "clientdescription": {{#quote}}{{client.description}}{{/quote}},
        "sitename": {{#quote}}{{sitename}}{{/quote}}
    }{{/str}}
</h2>

<ul>
    {{#requestedscopes}}
        <li><strong>{{summary}}: </strong>{{description}}</li>
    {{/requestedscopes}}
</ul>

{{#hasgrantedscopes}}
<h2 class="h4">
    {{#str}}oauth2:confirmscopes:alreadygranted, moodle, {
        "clientname": {{#quote}}{{client.name}}{{/quote}},
        "clientdescription": {{#quote}}{{client.description}}{{/quote}},
        "sitename": {{#quote}}{{sitename}}{{/quote}}
    }{{/str}}
</h2>

<ul>
    {{#grantedscopes}}
        <li><strong>{{summary}}: </strong>{{description}}</li>
    {{/grantedscopes}}
</ul>
{{/hasgrantedscopes}}

<h2 class="h4">
    {{#str}}oauth2:confirmscopes:makesureyoutrust, moodle, {
        "clientname": {{#quote}}{{client.name}}{{/quote}},
        "clientdescription": {{#quote}}{{client.description}}{{/quote}},
        "sitename": {{#quote}}{{sitename}}{{/quote}}
    }{{/str}}
</h2>

<div>
    {{#str}}oauth2:confirmscopes:moodleaccount, moodle, {
        "clientname": {{#quote}}{{client.name}}{{/quote}},
        "clientdescription": {{#quote}}{{client.description}}{{/quote}},
        "profilelink": {{#quote}}{{userinfo.profileurl}}{{/quote}},
        "sitename": {{#quote}}{{sitename}}{{/quote}}
    }{{/str}}
</div>
