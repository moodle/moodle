{{!
    @template core/primarymoremenu

    React-rendered primary navigation for the top navbar, using core/nav/PrimaryNav (a thin alias
    for the shared core/nav/Nav engine), pointed at the navbar through its navbarstyle/measuredclass
    props.

    The mount point deliberately does not carry the legacy "moremenu" class (unlike the NonJS
    fallback nested inside it, which still needs it), mirroring how the mount point's own
    "primarynav-navbar" class is used: theme_boost's .moremenu rules are written for the legacy
    markup, where each overflow entry is an <li> wrapping an <a class="dropdown-item">, so against
    React's own dropdown-items they would zero the padding and stamp a tick over the active one.

    Includes a server-rendered core/moremenu_children fallback inside the mount point, used by
    NonJS Behat and no-JS browsers. It carries "observed" because theme_boost's .moremenu rule
    keeps the nav hidden until core/moremenu.js adds that class, and this template deliberately
    does not load that module: React owns the overflow split, so the fallback is always settled.

    Example context (json):
    {
        "moremenuid": "614c104dbacfa",
        "navbarstyle": "navbar-nav",
        "istablist": false,
        "nodearray": [
            {
                "key": "home",
                "text": "Home",
                "url": "https://example.com/",
                "isactive": true
            },
            {
                "key": "mycourses",
                "text": "My courses",
                "url": "https://example.com/my/courses.php"
            }
        ],
        "reactprops": "{\"items\":[{\"key\":\"home\",\"text\":\"Home\",\"title\":null,\"href\":\"https://example.com/\",\"active\":true,\"forceintomoremenu\":false,\"showchildreninsubmenu\":false,\"id\":null,\"attributes\":[],\"actions\":[],\"divider\":false,\"children\":[]}],\"morelabel\":\"More\",\"navbarstyle\":\"navbar-nav\",\"istablist\":false,\"measuredclass\":\"primarynav-measured\"}"
    }
}}
{{#reactprops}}
{{#react}}
{
    "component": "@moodle/lms/core/nav/PrimaryNav",
    "class": "primarynav-navbar navigation",
    "props": {{{reactprops}}}
}
<nav class="moremenu observed navigation">
    <ul id="moremenu-{{moremenuid}}-{{navbarstyle}}" role="{{#istablist}}tablist{{/istablist}}{{^istablist}}menubar{{/istablist}}" class="nav more-nav {{navbarstyle}}">
        {{#nodecollection}}
            {{#children}}
                {{> core/moremenu_children}}
            {{/children}}
        {{/nodecollection}}
        {{#nodearray}}
            {{> core/moremenu_children}}
        {{/nodearray}}
        <li role="none" class="nav-item dropdown dropdownmoremenu d-none" data-region="morebutton">
            <a class="dropdown-toggle nav-link" href="#" id="moremenu-dropdown-{{moremenuid}}" role="{{#istablist}}tab{{/istablist}}{{^istablist}}menuitem{{/istablist}}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" tabindex="-1">
                {{#str}}moremenu, core{{/str}}
            </a>
            <ul class="dropdown-menu dropdown-menu-start" data-region="moredropdown" aria-labelledby="moremenu-dropdown-{{moremenuid}}" role="menu">
            </ul>
        </li>
    </ul>
</nav>
{{/react}}
{{/reactprops}}
