{{!
    @template core_grades/manage_outcomes_action_bar

    Actions bar for the manage outcomes page.

    Context variables required for this template:
    * assignoutcomesbutton - The data object containing the required properties to render the 'Assign site-wide...' button.
    * addoutcomebutton - The data object containing the required properties to render the 'add a new outcome' button.
    * importoutcomesbutton - The data object containing the required properties to render the 'import outcomes' button.
    * exportoutcomesbutton - The data object containing the required properties to render the 'export outcomes' button.

    Example context (json):
    {
        "assignoutcomesbutton": {
            "id": "single_button12345",
            "method" : "get",
            "classes": "singlebutton",
            "formid": null,
            "url" : "#",
            "primary" : false,
            "tooltip" : null,
            "label" : "Assign site-wide learning outcomes",
            "attributes": []
        },
        "addoutcomebutton": {
            "id": "single_button13245",
            "method" : "get",
            "classes": "singlebutton",
            "formid": null,
            "url" : "#",
            "primary" : true,
            "tooltip" : null,
            "label" : "Add a new outcome",
            "attributes": []
        },
        "importoutcomesbutton": {
            "id": "action_link14325",
            "disabled": false,
            "url" : "#",
            "classes": "btn btn-outline-secondary",
            "attributes": [],
            "icon": {
                "key": "t/down",
                "component": "core",
                "title": "Import outcomes"
            },
            "text": "Import outcomes"
        },
        "exportoutcomesbutton": {
            "id": "action_link15245",
            "disabled": false,
            "url" : "#",
            "classes": "btn btn-outline-secondary",
            "attributes": [],
            "icon": {
                "key": "t/up",
                "component": "core",
                "title": "Export all outcomes"
            },
            "text": "Export all outcomes"
        }
    }
}}
<div class="container-fluid tertiary-navigation full-width-bottom-border">
    <div class="d-flex">
        {{#assignoutcomesbutton}}
            <div class="navitem">
                {{>core/single_button}}
            </div>
        {{/assignoutcomesbutton}}
        {{#addoutcomebutton}}
            <div class="navitem">
                {{>core/single_button}}
            </div>
        {{/addoutcomebutton}}
        <div class="ms-auto d-flex">
            {{#importoutcomesbutton}}
                <div class="navitem">
                    {{>core/action_link}}
                </div>
            {{/importoutcomesbutton}}
            {{#exportoutcomesbutton}}
                <div class="navitem">
                    {{>core/action_link}}
                </div>
            {{/exportoutcomesbutton}}
        </div>
    </div>
</div>
